{
  "name": "bml-lang",
  "version": "0.9.0",
  "description": "A little Standard ML, in plain JavaScript",
  "type": "module",
  "license": "MIT",
  "author": "David M. Berry",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/critical-code-studies/BML.git"
  },
